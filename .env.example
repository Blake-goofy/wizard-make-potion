NODE_ENV=development
APP_ENV=development
API_PORT=8787
WEB_ORIGIN=http://localhost:5173
# Production API: set WEB_ORIGIN to the public https web site origin for Stripe redirects.
# Use WEB_ORIGINS only for additional CORS origins.

# Web build-time API origin. Leave blank for local same-origin `/api` requests through the Vite proxy.
VITE_API_BASE_URL=

# Supabase Postgres connection strings. Run `supabase start` before using local database-backed flows.
DATABASE_URL_DEV=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL_PROD=replace-with-production-database-url

# Session signing secret for the active environment. Seeded local users live in Supabase migrations.
# Local admin: admin@wizardmakepotion.local / change-me-locally
# Local scanner user: scanner@wizardmakepotion.local / change-me-locally
# New customer accounts queue verification codes and ticket emails for Resend delivery.
AUTH_SESSION_SECRET=replace-with-a-long-local-secret

# Provider credentials. `APP_ENV=development` prefers `*_DEV`, and `APP_ENV=production` prefers `*_PROD`.
STRIPE_SECRET_KEY_DEV=sk_test_xxx
STRIPE_PUBLISHABLE_KEY_DEV=pk_test_xxx
STRIPE_WEBHOOK_SECRET_DEV=whsec_xxx
STRIPE_SECRET_KEY_PROD=sk_live_xxx
STRIPE_PUBLISHABLE_KEY_PROD=pk_live_xxx
STRIPE_WEBHOOK_SECRET_PROD=whsec_xxx

# Email always sends through Resend.
EMAIL_FROM_ADDRESS_DEV=onboarding@resend.dev
EMAIL_FROM_NAME_DEV=Wizard Make Potion Dev
EMAIL_FROM_ADDRESS_PROD=tickets@wizardmakepotion.com
EMAIL_FROM_NAME_PROD=Wizard Make Potion Tickets

# Resend setup: replace re_xxxxxxxxx with the real API key for the stage you run.
# For Resend sandbox testing, use onboarding@resend.dev as the from address.
RESEND_API_KEY_DEV=re_xxxxxxxxx
RESEND_API_KEY_PROD=re_xxxxxxxxx

# Telnyx SMS setup. The API reads *_DEV in development mode and *_PROD in production mode.
TELNYX_API_KEY_DEV=KEY000ABC
TELNYX_API_KEY_PROD=KEY000ABC
# Use a dedicated sender number or a messaging profile for outbound sends.
TELNYX_SMS_FROM_NUMBER_DEV=+18445550001
TELNYX_SMS_FROM_NUMBER_PROD=+18445559999
TELNYX_MESSAGING_PROFILE_ID_DEV=
TELNYX_MESSAGING_PROFILE_ID_PROD=
# Webhook verification uses the Telnyx public key from Mission Control. Base64 or PEM both work.
TELNYX_PUBLIC_KEY_DEV=
TELNYX_PUBLIC_KEY_PROD=
