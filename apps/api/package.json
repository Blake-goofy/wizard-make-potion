{
  "name": "@potion/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development APP_ENV=development tsx watch src/index.ts",
    "build": "npm --prefix ../.. run build:api:deps && tsc -p tsconfig.json",
    "start": "node dist/apps/api/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "latest",
    "@fastify/static": "^10.1.5",
    "@potion/db": "*",
    "@potion/email": "*",
    "@potion/shared": "*",
    "dotenv": "latest",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "stripe": "^22.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "latest"
  }
}
