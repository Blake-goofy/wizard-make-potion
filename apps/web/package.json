{
  "name": "@potion/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:theme": "node ./scripts/sync-theme.mjs",
    "predev": "npm run sync:theme",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run sync:theme",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "pretypecheck": "npm run sync:theme",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@potion/shared": "*",
    "jsqr": "latest",
    "qrcode": "^1.5.4",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "vite": "latest"
  }
}
